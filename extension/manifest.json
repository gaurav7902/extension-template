{
    "manifest_version": 3,
    "name": "{{EXTENSION_NAME}}",
    "version": "0.1.0",
    "description": "{{EXTENSION_DESCRIPTION}}",
    "browser_specific_settings": {
        "gecko": {
            "id": "{{EXTENSION_SLUG}}@example.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "{{EXTENSION_NAME}}",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["*://{{TARGET_DOMAIN}}/*", "*://*.{{TARGET_DOMAIN}}/*"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "darktheme.css",
                "desert.css",
                "monokai.css",
                "imgs/*",
                "icons/*"
            ],
            "matches": ["*://{{TARGET_DOMAIN}}/*", "*://*.{{TARGET_DOMAIN}}/*"]
        }
    ]
}